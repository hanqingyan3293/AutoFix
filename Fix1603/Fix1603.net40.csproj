<!-- 兼容版：目标 .NET Framework 4.0，可在任何装有 .NET 4.x 的机器（含 Win7 SP1）直接运行。 -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net40</TargetFramework>
    <AssemblyName>Fix1603</AssemblyName>
    <RootNamespace>Fix1603</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Autodesk 1603 错误修复工具</AssemblyTitle>
    <Product>Fix1603</Product>
    <Version>1.0.0</Version>
    <Company>Qianxun</Company>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" />
  </ItemGroup>

</Project>
